<Layouts.app flash={@flash}>
  <section class="relative overflow-hidden rounded-[2rem] border border-stroke/60 bg-surface/55 p-6 shadow-lg shadow-black/30 backdrop-blur sm:p-10">
    <div class="pointer-events-none absolute inset-0">
      <div class="absolute -top-24 left-10 h-72 w-72 rounded-full bg-accent/12 blur-3xl" />
      <div class="absolute -bottom-28 right-10 h-80 w-80 rounded-full bg-accent-2/10 blur-3xl" />
      <div class="absolute inset-0 bg-linear-to-b from-transparent via-transparent to-black/15" />
    </div>

    <div class="relative">
      <p class="text-xs font-semibold tracking-[0.3em] text-text-muted">STREAM DONATIONS</p>
      <h1 class="mt-4 font-display text-4xl tracking-tight text-text sm:text-5xl">Donatex</h1>
      <p class="mt-4 max-w-xl text-sm leading-6 text-text-muted sm:text-base">
        Dark-only QRIS donations for live streams: one QR per transaction, alerts after payment confirmation,
        and a tiny admin surface to replay missed alerts.
      </p>

      <div class="mt-8 grid gap-3 sm:grid-cols-2">
        <a
          href={~p"/donate"}
          class="group relative overflow-hidden rounded-3xl border border-stroke/60 bg-background/35 px-5 py-5 shadow-sm shadow-black/30 transition hover:border-stroke hover:bg-background/45"
        >
          <div class="absolute -right-14 -top-20 h-44 w-44 rounded-full bg-accent/10 blur-2xl transition group-hover:bg-accent/14" />
          <div class="relative flex items-start justify-between gap-4">
            <div>
              <div class="text-xs font-semibold uppercase tracking-[0.2em] text-text-muted">
                Donor page
              </div>
              <div class="mt-2 text-xl font-semibold text-text">Open Donate</div>
              <div class="mt-2 text-sm text-text-muted">
                Mobile-first donation flow with Mayar dynamic QRIS.
              </div>
            </div>
            <div class="mt-1 text-text-muted transition group-hover:text-text" aria-hidden="true">
              &rarr;
            </div>
          </div>
        </a>

        <a
          href={~p"/admin"}
          class="group relative overflow-hidden rounded-3xl border border-stroke/60 bg-background/35 px-5 py-5 shadow-sm shadow-black/30 transition hover:border-stroke hover:bg-background/45"
        >
          <div class="absolute -left-16 -bottom-20 h-44 w-44 rounded-full bg-accent-2/10 blur-2xl transition group-hover:bg-accent-2/14" />
          <div class="relative flex items-start justify-between gap-4">
            <div>
              <div class="text-xs font-semibold uppercase tracking-[0.2em] text-text-muted">
                Operator
              </div>
              <div class="mt-2 text-xl font-semibold text-text">Open Admin</div>
              <div class="mt-2 text-sm text-text-muted">
                Review donations and replay alerts when needed.
              </div>
            </div>
            <div class="mt-1 text-text-muted transition group-hover:text-text" aria-hidden="true">
              &rarr;
            </div>
          </div>
        </a>
      </div>

      <div class="mt-6 rounded-2xl border border-stroke/60 bg-background/35 px-4 py-3 text-xs text-text-muted">
        <div class="font-semibold text-text">OBS overlay</div>
        <div class="mt-1">
          Configure your secret overlay token, then use <span class="text-text">/overlay/&lt;token&gt;</span>.
        </div>
      </div>
    </div>
  </section>
</Layouts.app>
